{
  "rewrites": [
    {
      "source": "/((?!api/|_next/|static/|.*\\.\\w+).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw-push-listener.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}